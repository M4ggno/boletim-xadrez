# Copie para .env.local e preencha com os seus valores reais.
# Nunca commite .env.local.

# MongoDB Atlas: use o URI de conexão do seu cluster (Database > Connect > Drivers).
# O mesmo URI serve para desenvolvimento local e produção na Vercel.
MONGODB_URI="mongodb+srv://SEU_USUARIO:SUA_SENHA@SEU_CLUSTER.mongodb.net/boletim?retryWrites=true&w=majority"

# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="COLOQUE_AQUI_UMA_CHAVE_ALEATORIA_LONGA"

# Necessário apenas no desenvolvimento local.
# Em produção na Vercel, o NextAuth v4 utiliza VERCEL_URL automaticamente.
NEXTAUTH_URL="http://localhost:3000"
